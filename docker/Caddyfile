{
	admin off
	auto_https off
	frankenphp {
		num_threads 8
	}
}

:80 {
	root * /app/public
	encode zstd br gzip

	header -Server
	header -X-Powered-By

	@immutable path /build/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	php_server {
		index index.php
	}

	file_server

	request_body {
		max_size 2MB
	}
}
